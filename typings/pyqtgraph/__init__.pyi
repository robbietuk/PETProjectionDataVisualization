# Partial type stubs for pyqtgraph, used only by the type checker (Pyrefly; see [tool.pyrefly] in pyproject.toml).
#
# pyqtgraph ships no type information (no py.typed), much of its API takes ``*args, **kwargs`` and some methods
# exist only through ``__getattr__`` forwarding (PlotWidget -> PlotItem, GraphicsLayoutWidget -> layout), so its
# inferred types are unusable under strict checking. This stub declares exactly the part of the API the viewer
# uses, with the argument forms the viewer passes. It is not installed and never imported at run time.
# Extend it when the view starts using more of pyqtgraph.
from typing import overload

from typing_extensions import override  # stubs are never run: typeshed's stub of it is enough

import numpy as np
import numpy.typing as npt
from PySide6 import QtCore, QtGui, QtWidgets

from . import colormap as colormap
from . import exporters as exporters
from .colormap import ColorMap as ColorMap

def setConfigOptions(*, imageAxisOrder: str = ..., antialias: bool = ...) -> None: ...
def mkPen(color: str | None = ..., *, width: float = ...) -> QtGui.QPen: ...

class GraphicsScene(QtWidgets.QGraphicsScene):
    sigMouseMoved: QtCore.SignalInstance            # emits the scene position (QPointF)

class GraphicsObject(QtWidgets.QGraphicsObject): ...

class AxisItem(GraphicsObject):
    def setPen(self, pen: QtGui.QPen) -> None: ...
    def setTextPen(self, pen: QtGui.QPen) -> None: ...

class LabelItem(QtWidgets.QGraphicsWidget):
    text: str
    def setAttr(self, attr: str, value: object) -> None: ...

class ViewBox(QtWidgets.QGraphicsWidget):
    def updateAutoRange(self) -> None: ...
    def mapSceneToView(self, obj: QtCore.QPointF) -> QtCore.QPointF: ...

class ImageItem(GraphicsObject):
    def setImage(self, image: npt.NDArray[np.floating] | None = ..., *, autoLevels: bool | None = ...) -> None: ...
    def setRect(self, rect: QtCore.QRectF) -> None: ...

class PlotDataItem(GraphicsObject):
    @override
    def setData(  # pyrefly: ignore[bad-override]  # pyqtgraph really replaces QGraphicsItem.setData(key, value)
        self, x: list[float], y: list[float]) -> None: ...
    def setPen(self, pen: QtGui.QPen) -> None: ...
    def setSymbolBrush(self, color: str) -> None: ...
    def setSymbolPen(self, color: str) -> None: ...

class InfiniteLine(GraphicsObject):
    def __init__(self, pos: float | None = ..., angle: float = ..., *, movable: bool = ...) -> None: ...
    def setPen(self, pen: QtGui.QPen) -> None: ...
    def setValue(self, v: float) -> None: ...

class GradientEditorItem(GraphicsObject):
    def setColorMap(self, cm: ColorMap) -> None: ...

class PlotItem(QtWidgets.QGraphicsWidget):
    vb: ViewBox
    titleLabel: LabelItem
    @override
    def scene(self) -> GraphicsScene: ...
    def getAxis(self, name: str) -> AxisItem: ...
    def setTitle(self, title: str | None = ..., *, color: str = ..., size: str = ...) -> None: ...
    def setLabel(self, axis: str, text: str | None = ...) -> None: ...
    def setAspectLocked(self, lock: bool = ...) -> None: ...
    def invertY(self, b: bool = ...) -> None: ...
    def setMouseEnabled(self, x: bool | None = ..., y: bool | None = ...) -> None: ...
    def setMenuEnabled(self, enableMenu: bool = ...) -> None: ...
    def hideButtons(self) -> None: ...
    def addItem(self, item: QtWidgets.QGraphicsItem) -> None: ...
    def setRange(self, *, xRange: tuple[float, float] | None = ..., yRange: tuple[float, float] | None = ...,
                 padding: float | None = ...) -> None: ...

class HistogramLUTItem(QtWidgets.QGraphicsWidget):
    vb: ViewBox
    axis: AxisItem
    gradient: GradientEditorItem
    sigLevelChangeFinished: QtCore.SignalInstance
    def setImageItem(self, img: ImageItem) -> None: ...
    def getLevels(self) -> tuple[float, float]: ...   # the viewer uses the default 'mono' level mode
    def setLevels(self, min: float | None = ..., max: float | None = ...) -> None: ...
    def getHistogramRange(self) -> list[float]: ...                 # [min, max] of the histogram axis
    def setHistogramRange(self, mn: float, mx: float, padding: float = ...) -> None: ...
    def autoHistogramRange(self) -> None: ...

class GraphicsView(QtWidgets.QGraphicsView):
    def setBackground(self, background: str) -> None: ...

class GraphicsLayout(QtWidgets.QGraphicsWidget): ...

class GraphicsLayoutWidget(GraphicsView):
    ci: GraphicsLayout                     # the central item: the layout holding the plot and the histogram
    def addPlot(self, row: int | None = ..., col: int | None = ...) -> PlotItem: ...
    def addItem(self, item: QtWidgets.QGraphicsItem, row: int | None = ..., col: int | None = ...) -> None: ...

class PlotWidget(GraphicsView):
    def getPlotItem(self) -> PlotItem: ...
    # forwarded to the PlotItem by PlotWidget.__getattr__
    def setLabel(self, axis: str, text: str | None = ...) -> None: ...
    def setTitle(self, title: str | None = ...) -> None: ...
    def addItem(self, item: QtWidgets.QGraphicsItem) -> None: ...
    @overload
    def plot(self, x: list[float], y: list[float], *, symbol: str, symbolSize: float) -> PlotDataItem: ...
    @overload
    def plot(self) -> PlotDataItem: ...
